<#@ template debug="false" hostspecific="true" language="C#" compilerOptions="/nullable:enable /langversion:latest" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
namespace GenericFaces.Patterns;

<#
	bool first = true;
	string[] tArgs = new string[15], tParameters = new string[15], tCall = new string[15], tCallLess = new string[15];
	for (int i = 0, iPrev = -1, iDisplay = 1; i < 15; i++, iPrev++, iDisplay++)
	{
		if (first)
		{
			tArgs[i] = "T1";
			tParameters[i] = "out T1 t1";
			tCall[i] = "out t1";
			tCallLess[i] = "out _";
		}
		else
		{
			tArgs[i] = tArgs[iPrev] + $", T{iDisplay}";
			tParameters[i] = tParameters[iPrev] + $", out T{iDisplay} t{iDisplay}";
			tCall[i] = tCall[iPrev] + $", out t{iDisplay}";
			tCallLess[i] = tCall[iPrev] + $", out _";
		}
#>
public interface IDeconstructible<<#= tArgs[i] #>>
<#
		if (!first)
		{
#>
	: IDeconstructible<<#= tArgs[iPrev] #>>
<#
		}
#>
{
	public void Deconstruct(<#= tParameters[i] #>);
<#
		if (!first)
		{
#>
	void IDeconstructible<<#= tArgs[iPrev] #>>.Deconstruct(<#= tParameters[iPrev] #>) => Deconstruct(<#= tCallLess[i] #>);
<#
		}
#>
}

<#
		first = false;
	}
#>